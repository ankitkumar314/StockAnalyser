# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# LangSmith Configuration (Optional - for tracing and monitoring)
# Get your API key from: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=rag-agent-system
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# PostgreSQL Database Configuration (Optional - for data persistence)
# Format: postgresql://username:password@host:port/database
# Example: postgresql://stockuser:password123@localhost:5432/stockanalyser
DATABASE_URL=postgresql://user:password@localhost:5432/stockanalyser
# Zerodha Kite Connect (Optional - for portfolio holdings)
# With KITE_API_SECRET set, open http://localhost:8000/kite/login once a day;
# the app completes the session exchange at /redirect/zerodha and stores the
# day's access token automatically (no restart needed).
# KITE_ACCESS_TOKEN is only a manual fallback if you don't set the secret.
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here
KITE_ACCESS_TOKEN=your_kite_access_token_here

# Application Settings
# Add other environment variables as needed
